{
  "name": "ae",
  "version": "0.14.2",
  "description": "Agentic Engineering workflow for Claude Code. Multi-agent TDD, cross-family review (Claude + Codex + Gemini), structured planning and analysis.",
  "author": {
    "name": "ckai"
  },
  "repository": "https://github.com/xmkevinchen/agentic-engineering",
  "license": "MIT",
  "keywords": [
    "agentic-engineering",
    "tdd",
    "code-review",
    "cross-family",
    "multi-agent",
    "workflow-automation",
    "agent-teams"
  ],
  "userConfig": {
    "gemini_flash_model": {
      "title": "Gemini Flash Model",
      "description": "Gemini Flash model name",
      "type": "string",
      "default": "gemini-2.5-flash"
    },
    "gemini_pro_model": {
      "title": "Gemini Pro Model",
      "description": "Gemini Pro model name",
      "type": "string",
      "default": "gemini-2.5-pro"
    },
    "openai_compat_endpoint": {
      "title": "OpenAI-compatible endpoint",
      "description": "Base URL ending in /v1 for any OpenAI-compatible backend (oMLX, Ollama, LM Studio, vLLM, DeepSeek, Gemini's compat layer). The proxy can also pass one per call.",
      "type": "string",
      "default": "http://127.0.0.1:8000/v1"
    },
    "openai_compat_model": {
      "title": "OpenAI-compatible model",
      "description": "Default model id served by that endpoint. Leave empty to require the caller to name one.",
      "type": "string",
      "default": ""
    },
    "openai_compat_family": {
      "title": "Model family (weight lineage)",
      "description": "Lineage of the configured model \u2014 qwen, llama, gemma, deepseek. This is NOT the host it runs on; the distinction is load-bearing for cross-family coverage.",
      "type": "string",
      "default": "unknown"
    }
  },
  "outputStyles": [
    "./output-styles/ae-structured.md",
    "./output-styles/ae-compact.md"
  ],
  "mcpServers": {
    "codex": {
      "command": "codex",
      "args": [
        "mcp-server"
      ]
    },
    "gemini": {
      "command": "bash",
      "args": [
        "-c",
        "exec node \"${CLAUDE_PLUGIN_ROOT}/mcp-servers/gemini/dist/index.mjs\""
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "openai-compat": {
      "command": "bash",
      "args": [
        "-c",
        "exec node \"${CLAUDE_PLUGIN_ROOT}/mcp-servers/openai-compat/dist/index.mjs\""
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-cross-family.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/trace-rotate.sh"
          }
        ]
      }
    ]
  }
}
