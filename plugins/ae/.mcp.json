{
  "mcpServers": {
    "codex": {
      "command": "codex",
      "args": ["mcp-server"]
    },
    "gemini": {
      "command": "bash",
      "args": ["-c", "exec node \"${CLAUDE_PLUGIN_ROOT}/mcp-servers/gemini/dist/index.mjs\""],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}
