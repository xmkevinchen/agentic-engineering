{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ae:bootstrap-handoff/evidence-manifest.schema.json",
  "title": "bootstrap evidence manifest",
  "description": "Closed shape of the per-attempt evidence manifest. An evidence directory holds DATA: the manifest indexes raw bytes and never carries a verdict, a summary that could disagree with them, or a verifier. Every entry is a repo-relative path with a raw-byte SHA-256, and validate-artifacts.sh additionally requires that each file exist, hash to the recorded digest, be a regular file rather than a symlink, and appear exactly once. Validated by the compact schema interpreter in validate-artifacts.sh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "artifact_version",
    "authority",
    "feature_id",
    "work_package",
    "attempt_id",
    "sealed_at",
    "commit",
    "entries"
  ],
  "properties": {
    "artifact_kind": { "const": "bootstrap_evidence_manifest" },
    "artifact_version": { "const": 1 },
    "authority": { "const": "bootstrap_non_authoritative" },
    "feature_id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
    "work_package": { "type": "string", "pattern": "^WP-[A-Za-z0-9._-]+$" },
    "attempt_id": { "type": "string", "pattern": "^A-[0-9]{3}$" },
    "sealed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "required", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
          "artifact_kind": {
            "description": "Closed set. A new evidence shape is a protocol change, not a free-text label — an unknown kind here would let an attempt introduce evidence no reviewer knows how to read.",
            "enum": [
              "definition_bytes_manifest",
              "intended_metadata_map",
              "quoting_allowlist",
              "byte_identity_check",
              "frontmatter_projection",
              "command_capture",
              "host_context",
              "host_state_observation",
              "effective_metadata_snapshot",
              "repo_state",
              "git_status_raw",
              "ignored_projection",
              "ignored_paths_raw",
              "e3_preregistration",
              "e3_execution_protocol",
              "e3_execution_result",
              "e3_arm_raw_output",
              "external_call_ledger"
            ]
          },
          "required": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer" }
        }
      }
    }
  }
}
