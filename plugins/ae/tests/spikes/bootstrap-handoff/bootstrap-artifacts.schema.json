{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ae:bootstrap-handoff/bootstrap-artifacts.schema.json",
  "title": "F-083 bootstrap handoff artifacts",
  "description": "Closed shapes for the five JSON artifacts of the manual Codex -> Claude Code -> Codex handoff. Selection is by artifact_kind: the six distributed *_template files carry a '*_template' kind, 'state: template', null identities and empty arrays, and are DELIBERATELY invalid as issued artifacts — an issued artifact must change its kind, so a template can never be mistaken for work. Reviews are Markdown and are checked by validate-artifacts.sh rather than here. The write-deny set below is REQUIRED, not advisory, and validate-artifacts.sh rejects any request whose allowed_paths overlaps it. Validated by the compact schema interpreter in validate-artifacts.sh, which supports type / properties / required / additionalProperties:false / items / minItems / enum / const / pattern / $ref -> #/$defs.",
  "type": "object",
  "required": ["artifact_kind"],
  "properties": {
    "artifact_kind": {
      "enum": [
        "bootstrap_work_request",
        "bootstrap_work_result",
        "bootstrap_verification_subject",
        "bootstrap_accepted_attempt",
        "bootstrap_implementation_continuation",
        "bootstrap_work_request_template",
        "bootstrap_work_result_template",
        "bootstrap_verification_subject_template",
        "bootstrap_accepted_attempt_template",
        "bootstrap_implementation_continuation_template"
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
    "feature_id": { "const": "F-083" },
    "work_package": { "type": "string", "pattern": "^WP-[A-Za-z0-9._-]+$" },
    "attempt_id": { "type": "string", "pattern": "^A-[0-9]{3}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9:.]+Z?)?$" },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plan_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "acceptance_section_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "acceptance_section_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ignored_roots_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "path", "sha256"],
      "properties": {
        "profile": { "const": "bootstrap_ignored_v1" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseline": {
      "description": "Bound even when the worktree is clean. Git is never treated as recovery for .ae/**, which is ignored, so the repo-state manifest and the ignored projection carry what a commit diff cannot.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "repo_state", "git_status", "ignored_roots"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "repo_state": { "$ref": "#/$defs/identity" },
        "git_status": { "$ref": "#/$defs/identity" },
        "ignored_roots": { "$ref": "#/$defs/ignored_roots_identity" }
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref", "decision_entry_sha256", "decision_register_sha256", "purpose"],
      "properties": {
        "decision_ref": { "type": "string", "pattern": "^[^\\\\]+#D-[0-9]{3}$" },
        "decision_entry_sha256": { "$ref": "#/$defs/sha256" },
        "decision_register_sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "command_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "expected_exit_codes"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "expected_exit_codes": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
      }
    },
    "command_record": {
      "description": "The issued form of a command_spec: it adds what actually happened and where the raw bytes live. A record without raw output is a summary, and a summary cannot stand in for evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "expected_exit_codes", "actual_exit_code", "raw_output"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "expected_exit_codes": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "actual_exit_code": { "type": "integer" },
        "raw_output": { "$ref": "#/$defs/identity" }
      }
    },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_kind", "required"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "artifact_kind": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "stop_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "condition", "required_action"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "condition": { "type": "string", "minLength": 1 },
        "required_action": { "type": "string", "minLength": 1 }
      }
    },
    "exact_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target", "expected_source_digest", "expected_target_absent"],
      "properties": {
        "kind": { "enum": ["quarantine", "rename", "delete"] },
        "source": { "$ref": "#/$defs/path" },
        "target": { "type": ["string", "null"] },
        "expected_source_digest": { "$ref": "#/$defs/sha256" },
        "expected_target_absent": { "type": "boolean" }
      }
    },
    "replacement_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "disposition", "owner", "evidence_sha256", "authority_reachability", "follow_up"],
      "properties": {
        "artifact": { "$ref": "#/$defs/path" },
        "disposition": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["codex", "claude", "human"] },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "authority_reachability": { "type": "string", "minLength": 1 },
        "follow_up": { "type": "string", "minLength": 1 }
      }
    },
    "feature_tree_mutation": {
      "description": "Defaults closed. Only WP-F082-APPLY may set allowed:true, and only with the exact human decision ref/digest plus the safe-view digest that decision bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "human_decision_ref", "human_decision_sha256", "approved_view_sha256", "exact_operations"],
      "properties": {
        "allowed": { "type": "boolean" },
        "human_decision_ref": { "type": ["string", "null"] },
        "human_decision_sha256": { "type": ["string", "null"] },
        "approved_view_sha256": { "type": ["string", "null"] },
        "exact_operations": { "type": "array", "items": { "$ref": "#/$defs/exact_operation" } }
      }
    },

    "bootstrap_work_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind", "artifact_version", "authority", "feature_id", "work_package",
        "attempt_id", "state", "branch", "material_revision", "strategy_revision",
        "baseline_before", "plan", "frozen_goal", "source_set", "human_approvals",
        "acceptance_ids", "source_inputs", "allowed_paths", "forbidden_paths",
        "feature_tree_mutation", "commands", "expected_evidence", "stop_conditions",
        "replacement_dispositions", "rollout_lock_forbidden", "same_session_review_forbidden"
      ],
      "properties": {
        "artifact_kind": { "const": "bootstrap_work_request" },
        "artifact_version": { "const": 1 },
        "authority": { "const": "bootstrap_non_authoritative" },
        "feature_id": { "$ref": "#/$defs/feature_id" },
        "work_package": { "$ref": "#/$defs/work_package" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "state": { "const": "assigned" },
        "branch": { "type": "string", "minLength": 1 },
        "material_revision": { "type": "string", "minLength": 1 },
        "strategy_revision": { "type": "string", "minLength": 1 },
        "baseline_before": { "$ref": "#/$defs/baseline" },
        "plan": { "$ref": "#/$defs/plan_identity" },
        "frozen_goal": { "$ref": "#/$defs/identity" },
        "source_set": { "$ref": "#/$defs/identity" },
        "human_approvals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/human_approval" } },
        "acceptance_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^AC[0-9]+$" } },
        "source_inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identity" } },
        "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "forbidden_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "feature_tree_mutation": { "$ref": "#/$defs/feature_tree_mutation" },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command_spec" } },
        "expected_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expected_evidence" } },
        "stop_conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop_condition" } },
        "replacement_dispositions": { "type": "array", "items": { "$ref": "#/$defs/replacement_disposition" } },
        "rollout_lock_forbidden": { "const": true },
        "same_session_review_forbidden": { "const": true }
      }
    },

    "bootstrap_work_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind", "artifact_version", "authority", "feature_id", "work_package",
        "attempt_id", "state", "request", "material_revision", "strategy_revision",
        "plan", "frozen_goal", "source_set", "baseline_before", "baseline_after",
        "changed_files", "ignored_path_changes", "commits", "commands",
        "evidence_manifest", "replacement_dispositions", "deviations", "unresolved",
        "executor_summary"
      ],
      "properties": {
        "artifact_kind": { "const": "bootstrap_work_result" },
        "artifact_version": { "const": 1 },
        "authority": { "const": "bootstrap_non_authoritative" },
        "feature_id": { "$ref": "#/$defs/feature_id" },
        "work_package": { "$ref": "#/$defs/work_package" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "state": { "const": "review_pending" },
        "request": { "$ref": "#/$defs/identity" },
        "material_revision": { "type": "string", "minLength": 1 },
        "strategy_revision": { "type": "string", "minLength": 1 },
        "plan": { "$ref": "#/$defs/plan_identity" },
        "frozen_goal": { "$ref": "#/$defs/identity" },
        "source_set": { "$ref": "#/$defs/identity" },
        "baseline_before": { "$ref": "#/$defs/baseline" },
        "baseline_after": { "$ref": "#/$defs/baseline" },
        "changed_files": {
          "description": "A canonical index, never a substitute for the manifests. Review recomputes the commit diff, the index/worktree diff, and both ignored projections regardless of what this says.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "change", "before_sha256", "after_sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "change": { "enum": ["added", "modified", "deleted"] },
              "before_sha256": { "type": ["string", "null"] },
              "after_sha256": { "type": ["string", "null"] }
            }
          }
        },
        "ignored_path_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "change", "before_sha256", "after_sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "change": { "enum": ["added", "modified", "deleted"] },
              "before_sha256": { "type": ["string", "null"] },
              "after_sha256": { "type": ["string", "null"] }
            }
          }
        },
        "commits": { "type": "array", "items": { "$ref": "#/$defs/sha1" } },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command_record" } },
        "evidence_manifest": { "$ref": "#/$defs/identity" },
        "replacement_dispositions": { "type": "array", "items": { "$ref": "#/$defs/replacement_disposition" } },
        "deviations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unresolved": {
          "description": "Named stop-condition codes the attempt did not cross. An attempt that stopped at a human gate says so here; an empty array asserts nothing was left open.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "executor_summary": { "type": "string", "minLength": 1 }
      }
    },

    "bootstrap_verification_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind", "artifact_version", "authority", "feature_id", "work_package",
        "attempt_id", "state", "request", "result", "source_set", "baseline_before",
        "baseline_after", "evidence_manifest", "created", "writer_family"
      ],
      "properties": {
        "artifact_kind": { "const": "bootstrap_verification_subject" },
        "artifact_version": { "const": 1 },
        "authority": { "const": "bootstrap_non_authoritative" },
        "feature_id": { "$ref": "#/$defs/feature_id" },
        "work_package": { "$ref": "#/$defs/work_package" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "state": { "const": "review_pending" },
        "request": { "$ref": "#/$defs/identity" },
        "result": { "$ref": "#/$defs/identity" },
        "source_set": { "$ref": "#/$defs/identity" },
        "baseline_before": { "$ref": "#/$defs/baseline" },
        "baseline_after": { "$ref": "#/$defs/baseline" },
        "evidence_manifest": { "$ref": "#/$defs/identity" },
        "created": { "$ref": "#/$defs/timestamp" },
        "writer_family": { "const": "anthropic" }
      }
    },

    "bootstrap_accepted_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind", "artifact_version", "authority", "feature_id", "work_package",
        "attempt_id", "state", "request", "result", "verification_subject", "review",
        "source_set", "baseline_before", "baseline_after", "evidence_manifest",
        "created", "writer_family"
      ],
      "properties": {
        "artifact_kind": { "const": "bootstrap_accepted_attempt" },
        "artifact_version": { "const": 1 },
        "authority": { "const": "bootstrap_non_authoritative" },
        "feature_id": { "$ref": "#/$defs/feature_id" },
        "work_package": { "$ref": "#/$defs/work_package" },
        "attempt_id": { "$ref": "#/$defs/attempt_id" },
        "state": { "const": "accepted" },
        "request": { "$ref": "#/$defs/identity" },
        "result": { "$ref": "#/$defs/identity" },
        "verification_subject": { "$ref": "#/$defs/identity" },
        "review": { "$ref": "#/$defs/identity" },
        "source_set": { "$ref": "#/$defs/identity" },
        "baseline_before": { "$ref": "#/$defs/baseline" },
        "baseline_after": { "$ref": "#/$defs/baseline" },
        "evidence_manifest": { "$ref": "#/$defs/identity" },
        "created": { "$ref": "#/$defs/timestamp" },
        "writer_family": { "const": "openai" }
      }
    },

    "bootstrap_implementation_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind", "artifact_version", "authority", "feature_id",
        "source_work_package", "state", "p0_0_accepted_attempt", "p0_g_accepted_attempt",
        "program_decision", "qualification_target", "implementation_next_allowed",
        "rollout_blockers", "feature_closeout", "rollout_eligible",
        "rollout_lock_forbidden", "created", "writer_family"
      ],
      "properties": {
        "artifact_kind": { "const": "bootstrap_implementation_continuation" },
        "artifact_version": { "const": 1 },
        "authority": { "const": "bootstrap_non_authoritative" },
        "feature_id": { "$ref": "#/$defs/feature_id" },
        "source_work_package": { "const": "WP-P0.G" },
        "state": { "const": "reviewed" },
        "p0_0_accepted_attempt": { "$ref": "#/$defs/identity" },
        "p0_g_accepted_attempt": { "$ref": "#/$defs/identity" },
        "program_decision": { "enum": ["continue_mainline", "stop_mainline", "blocked"] },
        "qualification_target": { "const": "P0.8" },
        "implementation_next_allowed": { "type": ["string", "null"] },
        "rollout_blockers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["f082_partition"],
          "properties": { "f082_partition": { "enum": ["open", "closed", "pending-audit"] } }
        },
        "feature_closeout": { "type": ["string", "null"] },
        "rollout_eligible": { "const": false },
        "rollout_lock_forbidden": { "const": true },
        "created": { "$ref": "#/$defs/timestamp" },
        "writer_family": { "const": "openai" }
      }
    }
  },

  "x-required-write-denials": {
    "description": "Every issued request MUST deny each of these, and none may overlap allowed_paths. Omission or overlap invalidates the request before any work. These are the surfaces where a bootstrap attempt could manufacture authority it does not have.",
    "patterns": [
      ".git/**",
      "docs/ae-v1-design-history/finalized/**",
      ".ae/features/active/F-083-ae-v1-implementation/plan.md",
      ".ae/features/active/F-083-ae-v1-implementation/goal.frozen.md",
      ".ae/features/active/F-083-ae-v1-implementation/decision-register.md",
      ".ae/features/active/F-083-ae-v1-implementation/handoff-protocol.md",
      ".ae/features/active/F-083-ae-v1-implementation/index.md",
      ".ae/features/active/F-083-ae-v1-implementation/review.md",
      ".ae/features/active/F-083-ae-v1-implementation/reviews/**",
      ".ae/features/active/F-083-ae-v1-implementation/handoffs/**/work-request.json",
      ".ae/features/active/F-083-ae-v1-implementation/handoffs/**/accepted-attempt.json",
      ".ae/features/active/F-083-ae-v1-implementation/handoffs/**/implementation-continuation.json",
      ".ae/rollout/**",
      ".ae/transactions/rollout/**",
      "plugins/ae/policies/qualifications/**"
    ]
  }
}
