{
  "name": "@anthropic/ae-openai-compat-mcp",
  "version": "0.1.0",
  "description": "OpenAI-compatible MCP server for Agentic Engineering cross-family review — one bridge, many backends, endpoint and model chosen per call",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "ae-openai-compat-mcp": "dist/index.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "build": "npm run typecheck && npm run bundle",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
